<mxfile host="build_diagram.py"><diagram id="arch" name="Архітектура"><mxGraphModel dx="1720" dy="1090" grid="1" gridSize="10" guides="1" page="1" pageWidth="1720" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;telco-platform-lite — AI-платформа утримання клієнтів: 4 рівні, шлях запиту, межі довіри&lt;/b&gt;" style="text;html=1;fontSize=19;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1100" height="30" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;ІНТЕРНЕТ — недовірена зона&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;fontSize=13;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="320" height="300" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;CONTROL PLANE — рідкісні зміни лише через PR, кожна в аудиті&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;fontSize=13;fontColor=#7c3aed;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="1310" height="150" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;DATA PLANE — шлях кожного запиту&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;verticalAlign=top;align=right;spacingRight=12;fontSize=13;fontColor=#0284c7;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="1020" height="815" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;ЗОВНІШНІ ІНСТРУМЕНТИ (MCP)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;fontSize=13;fontColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="1440" y="525" width="250" height="330" as="geometry"/></mxCell><mxCell id="v6" value="4 · ПЛАТФОРМА" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0369a1;opacity=80;horizontal=0;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#0369a1;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="275" width="990" height="240" as="geometry"/></mxCell><mxCell id="v7" value="3 · АГЕНТ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;opacity=80;horizontal=0;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#b45309;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="525" width="990" height="160" as="geometry"/></mxCell><mxCell id="v8" value="2 · LLM" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;opacity=80;horizontal=0;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#15803d;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="695" width="990" height="150" as="geometry"/></mxCell><mxCell id="v9" value="1 · ML" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;opacity=80;horizontal=0;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#be185d;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="855" width="990" height="185" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;API-шлюз (gateway.py) — один middleware, кроки по черзі&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0369a1;strokeWidth=1.6;verticalAlign=top;align=right;spacingRight=12;fontSize=13;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="915" height="122" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;③ Сервіс: агент утримання (agent.py)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=12;fontSize=13;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="460" y="548" width="915" height="127" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1d4ed8&#x27;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; шлях запиту ①→⑤&lt;br&gt;&lt;font color=&#x27;#475569&#x27;&gt;──▶&lt;/font&gt; внутрішній виклик&lt;br&gt;&lt;font color=&#x27;#ea580c&#x27;&gt;──▶&lt;/font&gt; виклик зовнішнього інструменту&lt;br&gt;&lt;font color=&#x27;#15803d&#x27;&gt;- - ▶&lt;/font&gt; запис витрат&lt;br&gt;&lt;font color=&#x27;#7c3aed&#x27;&gt;··▶&lt;/font&gt; конфігурація з control plane&lt;br&gt;&lt;font color=&#x27;#dc2626&#x27;&gt;&lt;b&gt;— —&lt;/b&gt;&lt;/font&gt; межа довіри A, B, C&lt;br&gt;&lt;br&gt;&lt;b&gt;Чотири рівні:&lt;/b&gt; ML → LLM → агент → платформа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="575" width="320" height="300" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Клієнт&lt;/b&gt;&lt;br&gt;менеджер утримання в CRM UI&lt;br&gt;орендар telco-crm&lt;br&gt;HTTPS + Bearer JWT" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="325" width="270" height="96" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;IdP (у демо — security.py)&lt;/b&gt;&lt;br&gt;видає JWT RS256:&lt;br&gt;sub, tenant_id, role" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="280" height="92" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Git: політика як код&lt;/b&gt;&lt;br&gt;rbac.yaml · idp.yaml · config.py&lt;br&gt;(MAX_AUTO_DISCOUNT) → PR-рев&amp;#x27;ю" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="320" height="92" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;IDP + CI/CD&lt;/b&gt;&lt;br&gt;маніфест → idp_validate.py&lt;br&gt;→ Terraform + Helm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="300" height="92" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Model registry + картка моделі&lt;/b&gt;&lt;br&gt;CI-gate: AUC ≥ 0.75,&lt;br&gt;інакше шлюз не стартує" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="310" height="92" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Черга схвалень&lt;/b&gt;&lt;br&gt;human-in-the-loop&lt;br&gt;(лише admin)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0369a1;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="437" width="205" height="68" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;RAG: колекція орендаря&lt;/b&gt;&lt;br&gt;векторна БД&lt;br&gt;(у демо — пошук за тегами)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="735" width="260" height="80" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;explainer-llm&lt;/b&gt;&lt;br&gt;vLLM + AWQ (у демо — stub&lt;br&gt;або OpenAI-сумісний API)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="735" width="300" height="80" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Перевірка faithfulness&lt;/b&gt;&lt;br&gt;RAGAS (у демо — лексичний&lt;br&gt;проксі) → low_confidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.6;